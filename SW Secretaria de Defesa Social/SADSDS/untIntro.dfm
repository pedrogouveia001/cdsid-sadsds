      StyleRenderOptions.RenderVisibility = True
      StyleRenderOptions.RenderStatus = True
      StyleRenderOptions.RenderAbsolute = True
      BGColor = clNone
      ConvertSpaces = False
      Font.Color = clNone
      Font.Size = 10
      Font.Style = []
      FriendlyName = 'txtconfirmation'
      Lines.Strings = (
        'Dear'
        'Thank you for using FITradeoff System.'
        ''
        
          'Here it is your temporary password, use it to access your FITrad' +
          'eoff account. '
        
          'As soon as you access the system, it will be required to create ' +
          'a new password.'
        ''
        'Temporary Password ='
        ''
        'In case of doubts, please contact us.'
        ''
        'Regards,'
        'FITradeoff Support.')
      RawText = False
      UseFrame = False
      WantReturns = True
    end
